            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          }
        },
        "summary": "Horarios de un dia para un tratamiento, con los cupos que quedan en cada uno.",
        "tags": [
          "Disponibilidad"
        ]
      }
    },
