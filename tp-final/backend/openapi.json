    "/api/v1/tenants/{tenantSlug}/servicios": {
      "get": {
        "operationId": "ServiciosController_findAll",
        "parameters": [
          {
            "name": "activo",
            "required": false,
            "in": "query",
            "description": "Filtra por estado. El front del cliente pide `activo=true`; el ABM no manda nada y ve\ntodo. Es un filtro comun y no un flag de autorizacion: un parametro que cambia el nivel\nde acceso de una ruta publica es lo que se rompe en el segundo refactor.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "limit",
            "required": true,
            "in": "query",
            "description": "Cuantos elementos devolver como maximo en esta pagina.",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "El nextCursor que devolvio la pagina anterior. Es opaco: mandalo tal cual.",
            "schema": {
              "maxLength": 512,
              "type": "string"
            }
          },
          {
            "name": "tenantSlug",
            "required": true,
            "in": "path",
            "description": "Identificador del centro en la URL, por ejemplo `lo-de-lili`.",
            "schema": {
              "example": "lo-de-lili",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Una pagina de resultados.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/CursorPageDto"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/ServicioDto"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "El centro no existe o esta inactivo.\n\nEl centro o el tratamiento no existe.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          }
        },
        "summary": "Catalogo de tratamientos del centro, paginado por cursor.",
        "tags": [
          "Servicios"
        ]
      },
      "post": {
        "operationId": "ServiciosController_create",
        "parameters": [
          {
            "name": "tenantSlug",
            "required": true,
            "in": "path",
            "description": "Identificador del centro en la URL, por ejemplo `lo-de-lili`.",
            "schema": {
              "example": "lo-de-lili",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateServicioDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServicioDto"
                }
              }
            }
          },
          "400": {
            "description": "Datos invalidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "401": {
            "description": "Falta el token o no es valido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "403": {
            "description": "El token es de otro centro, o de una cuenta que no es de administracion.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "404": {
            "description": "El centro no existe o esta inactivo.\n\nEl centro o el tratamiento no existe.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          },
          "409": {
            "description": "Ya hay un tratamiento con ese nombre.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Da de alta un tratamiento. Solo la administradora del centro.",
        "tags": [
          "Servicios"
        ]
      }
    },
