                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/CursorPageDto"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/ReservaDto"
                          }
