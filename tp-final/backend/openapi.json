              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "example": "2026-10-05",
              "type": "string"
            }
          },
          {
            "name": "tenantSlug",
            "required": true,
            "in": "path",
            "description": "Identificador del centro en la URL, por ejemplo `lo-de-lili`.",
