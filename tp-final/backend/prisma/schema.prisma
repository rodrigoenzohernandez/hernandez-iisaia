// Este archivo es la unica fuente del esquema. La migracion inicial es el baseline que
// genera Prisma: cero SQL a mano, cero EXCLUDE, cero CHECK, cero ALTER TABLE.
// Lo que un CHECK habria cubierto vive en los DTO y en los services.
//
// Convencion de idioma: sustantivos del dominio en espanol, infraestructura en ingles.
// Identificadores en ASCII, sin tildes ni enie.

generator client {
  // prisma-client-js y no el generador nuevo: tenancy/tenant-scope.ts lee Prisma.dmmf de aca.
  provider = "prisma-client-js"
}

datasource db {
  // Prisma 7 saco `url` de este bloque: la URL vive en prisma.config.ts para Migrate, y el
  // cliente se conecta con el driver adapter de src/prisma/prisma.module.ts.
  provider = "postgresql"
}

/// El rol del personal del centro. Las clientas no son usuarias del panel: tienen su propio
/// rol en el JWT, y el guard exige el rol de cada ruta en vez de la ficcion "si hay token
/// valido, es la duenia".
enum RolUsuario {
  admin
}

enum EstadoReserva {
  pendiente
  confirmada
  cancelada
  /// No vino. Lo marca el centro despues de la hora del turno; lo pagado no se devuelve.
  ausente
}

enum CanceladaPor {
  clienta
  centro
  /// Vencio sin pagarse.
  sistema
}

enum EstadoPago {
  pendiente
  aprobado
  rechazado
  cancelado
  reembolsado
  contracargo
  disputa
}

enum EstadoReembolso {
  pendiente
  aprobado
  fallido
}

enum MetodoPago {
  efectivo
  mercadopago
}

/// Los planes de la plataforma. Lo que habilita cada uno vive en src/planes/planes.ts.
enum Plan {
  basico
  profesional
}

enum EstadoNotificacion {
  pendiente
  enviada
  fallida
}

/// Raiz del arbol: el unico modelo sin tenantId y el unico que la extension no filtra.
/// No hay endpoint que lo lea ni que lo liste. Los tenants se crean por seed.
model Tenant {
  id     String @id @default(cuid())
  slug   String @unique
  nombre String

  /// La unica razon por la que el backend conoce zonas horarias: saber que dia y que hora
  /// es "ahora" en el centro, para rechazar turnos pasados. Todo lo demas es hora de pared.
  zonaHoraria String   @default("America/Argentina/Buenos_Aires")
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// La suscripcion del centro a la plataforma. Vive en la raiz y no en una tabla con
  /// tenantId porque el webhook de suscripciones llega a la ruta de la plataforma, sin centro
  /// en la URL: con la extension, una tabla filtrada seria inalcanzable desde ahi.
  ///
  /// El plan vigente no se guarda: se calcula de estos campos (src/planes/planes.ts), asi un
  /// plan no puede quedar activo porque un aviso no llego.
  suscripcionPlan   Plan?
  /// El id de la preapproval en Mercado Pago.
  suscripcionMpId   String?   @unique
  suscripcionEstado String?
  /// Donde la administradora autoriza la suscripcion, mientras esta pendiente.
  suscripcionUrl    String?
  /// Hasta cuando esta pago el plan. Cada cobro mensual aprobado lo extiende.
  planPagoHasta     DateTime?

  usuarios          Usuario[]
  servicios         Servicio[]
  ventanas          VentanaAtencion[]
  notificaciones    Notificacion[]
  clientes          Cliente[]
  codigosAcceso     CodigoAcceso[]
  cuentaMercadoPago CuentaMercadoPago?
}

/// La cuenta de la plataforma, que ve todos los centros. Global a proposito: no tiene
/// tenantId, y es la unica excepcion al chequeo de arranque ademas de Tenant. No hay alta por
/// la API: el unico que existe lo crea el seed.
model Superadmin {
  id           String   @id @default(cuid())
  email        String   @unique
  nombre       String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Usuario {
  id           String     @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  nombre       String
  rol          RolUsuario @default(admin)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  /// El mismo email puede administrar dos centros. Por eso el login vive bajo el path del
  /// tenant: sin tenant, el email no identifica a nadie.
  @@unique([tenantId, email])
}

model Servicio {
  id                 String  @id @default(cuid())
  tenantId           String
  nombre             String
  descripcion        String?
  duracionMinutos    Int
  precioCentavos     Int
  senaCentavos       Int
  requiereValoracion Boolean @default(false)
  activo             Boolean @default(true)

  /// Hasta cuantas horas antes del turno la clienta puede reprogramar sola, sin costo.
  /// null apaga la reprogramacion por autogestion: el centro puede siempre.
  reprogramacionHorasAntes Int?     @default(24)
  /// Hasta cuantas horas antes la clienta cancela con reembolso total. Despues, se pierde
  /// todo lo pagado.
  cancelacionHorasAntes    Int      @default(24)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  reservas Reserva[]

  /// Dos centros pueden tener "Depilacion". Ninguna unique de dominio vuelve a ser de una
  /// sola columna: todas arrancan con tenantId.
  @@unique([tenantId, nombre])
  /// No es decorativo: habilita la FK compuesta de Reserva.
  @@unique([tenantId, id])
}

/// Franja recurrente en la que el centro toma turnos, con cuantos acepta en simultaneo.
/// Varias por dia: maniana y tarde. capacidad > 1 ES el doble turno: configurable, no
/// imposible.
model VentanaAtencion {
  id       String @id @default(cuid())
  tenantId String

  /// 1 lunes .. 7 domingo (ISO-8601).
  diaSemana Int

  /// Hora de pared del centro, "HH:mm" con cero a la izquierda: el orden lexicografico
  /// coincide con el cronologico y Postgres lo resuelve con el indice.
  horaInicio String @db.VarChar(5)

  /// Minuto mas tardio en el que un turno puede TERMINAR, no cuando se cierra la puerta.
  /// Por eso la grilla depende de la duracion del servicio.
  horaFin String @db.VarChar(5)

  /// Separacion entre inicios de la grilla. 45 en el prototipo de Lo de Lili.
  intervaloMinutos Int @default(45)

  /// Turnos simultaneos aceptados en esta franja. Puede ser mayor a 1.
  capacidad Int @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  /// Una franja por dia y hora de inicio: es lo que hace idempotente al PUT de la
  /// coleccion. Sirve ademas de indice para la busqueda por dia, que es su prefijo.
  @@unique([tenantId, diaSemana, horaInicio])
}

model Reserva {
  id         String @id @default(cuid())
  tenantId   String
  servicioId String
  /// Toda reserva tiene duenia, tambien la que se hizo sin cuenta: se asocia por email.
  clienteId  String

  /// Dia del turno en hora de pared del centro.
  fecha      DateTime @db.Date
  horaInicio String   @db.VarChar(5)

  /// Snapshot: sobrevive a un cambio de duracion del servicio, y el conteo de solapes no
  /// necesita join.
  horaFin String @db.VarChar(5)

  estado          EstadoReserva @default(pendiente)
  clienteNombre   String
  clienteEmail    String
  clienteTelefono String
  notas           String?
  metodoPago      MetodoPago

  /// Snapshot del monto al momento de reservar, como el precio en una factura.
  senaCentavos   Int
  precioCentavos Int

  /// Lo que se cobra por Mercado Pago: la sena en efectivo, el precio con Mercado Pago, o 0
  /// si no hay nada que cobrar online.
  montoOnlineCentavos Int
  /// Hasta cuando el cupo espera el pago. Despues, la reserva deja de contar y vence.
  pagoVenceAt         DateTime?
  checkoutId          String?
  checkoutUrl         String?

  /// La politica que la clienta acepto al reservar, copiada como la sena: si el centro la
  /// endurece despues, el turno ya tomado conserva la suya.
  reprogramacionHorasAntes Int?
  cancelacionHorasAntes    Int

  canceladaPor CanceladaPor?
  canceladaAt  DateTime?

  /// Cuando salio el recordatorio. Tambien se marca al reservar dentro de las 24 horas
  /// previas: ahi el mail de confirmacion ya hace de recordatorio.
  recordatorioEnviadoAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// FKs compuestas: Postgres impide que una reserva apunte a un servicio o a una clienta de
  /// otro tenant aunque la aplicacion se equivoque. Son la segunda linea detras de la
  /// extension y cubren justo lo que la extension no ve: los include anidados.
  /// Reserva no tiene relacion directa a Tenant a proposito: el tenant se hereda del
  /// servicio y de la clienta, y las dos FKs lo obligan a ser el mismo.
  servicio Servicio @relation(fields: [tenantId, servicioId], references: [tenantId, id])
  cliente  Cliente  @relation(fields: [tenantId, clienteId], references: [tenantId, id])
  pagos    Pago[]

  /// Habilita la FK compuesta de Pago.
  @@unique([tenantId, id])
  /// Sostiene el listado paginado del admin y la query de solapes.
  @@index([tenantId, fecha, horaInicio])
  /// "Mis turnos": el listado de una clienta, en el mismo orden que el del admin.
  @@index([tenantId, clienteId, fecha, horaInicio])
  /// La tarea de vencimiento busca las impagas vencidas cada minuto.
  @@index([tenantId, estado, pagoVenceAt])
}

/// Una clienta del centro. No tiene contrasena: entra con un codigo que le llega por mail, y
/// la cuenta nace la primera vez que reserva o que entra. Es por centro, como la de
/// administracion: la misma persona en dos centros son dos clientas.
model Cliente {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  nombre    String?
  telefono  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  reservas Reserva[]

  @@unique([tenantId, email])
  /// Habilita la FK compuesta de Reserva.
  @@unique([tenantId, id])
}

/// Un codigo de ingreso de 6 digitos. Se guarda su HMAC, nunca el codigo: una base filtrada
/// no deja entrar a nadie, ni siquiera durante los diez minutos en que vale.
model CodigoAcceso {
  id         String    @id @default(cuid())
  tenantId   String
  email      String
  codigoHash String
  intentos   Int       @default(0)
  expiraAt   DateTime
  usadoAt    DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, email, createdAt])
}

/// Cola de mails (outbox). La fila se escribe en la MISMA transaccion que el cambio que la
/// origina, asi un turno confirmado nunca se queda sin su mail y un reintento de la
/// transaccion no lo manda dos veces. Una tarea la despacha y reintenta con backoff.
model Notificacion {
  id       String @id @default(cuid())
  tenantId String
  para     String
  asunto   String
  html     String
  texto    String

  estado           EstadoNotificacion @default(pendiente)
  intentos         Int                @default(0)
  /// Tambien hace de lease: quien despacha la corre para adelante antes de mandar, asi dos
  /// despachadores en paralelo no toman la misma fila.
  proximoIntentoAt DateTime           @default(now())
  proveedorId      String?
  ultimoError      String?
  enviadaAt        DateTime?
  /// Despues de esto el mail no sirve y la fila se borra: es el caso del codigo de ingreso,
  /// que es un secreto. De CodigoAcceso solo se guarda la firma, y aca no puede quedar el
  /// codigo en claro mas alla de su vencimiento.
  venceAt          DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, estado, proximoIntentoAt])
  @@index([tenantId, venceAt])
}

/// La cuenta de Mercado Pago del centro: ahi cae la plata de sus clientas. La deja OAuth, o
/// en pruebas el seed con credenciales de prueba; el resto del codigo no distingue una de
/// otra. Los tokens van cifrados con AES-256-GCM.
model CuentaMercadoPago {
  id                  String    @id @default(cuid())
  tenantId            String    @unique
  mpUserId            String
  accessTokenCifrado  String
  /// null en las cuentas sembradas: no vienen de OAuth y no se renuevan.
  refreshTokenCifrado String?
  publicKey           String
  scope               String
  liveMode            Boolean
  expiraAt            DateTime?
  /// MP revoco el token o rechazo la renovacion: hasta reconectar, el centro no cobra online.
  requiereReconexion  Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

/// Un pago de Mercado Pago de una reserva. Puede haber varios: un rechazo y despues una
/// aprobacion, o dos aprobados si alguien pago dos veces.
model Pago {
  id                  String     @id @default(cuid())
  tenantId            String
  reservaId           String
  /// El id del pago en Mercado Pago.
  proveedorId         String
  estado              EstadoPago
  estadoDetalle       String?
  montoCentavos       Int
  reembolsadoCentavos Int        @default(0)
  medio               String?
  aprobadoAt          DateTime?
  /// Cuando la aprobacion ya se aplico a la reserva: se confirmo o se devolvio. Se decide una
  /// sola vez: un pago que vuelve a aprobado despues de una disputa no se decide de nuevo.
  decididoAt          DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  reserva    Reserva     @relation(fields: [tenantId, reservaId], references: [tenantId, id])
  reembolsos Reembolso[]

  /// Un aviso repetido de MP no crea un pago dos veces.
  @@unique([tenantId, proveedorId])
  /// Habilita la FK compuesta de Reembolso.
  @@unique([tenantId, id])
  /// Los pagos de una reserva: se leen en cada reserva que sale por la API.
  @@index([tenantId, reservaId])
}

/// Un reembolso pedido. La fila se escribe en la misma transaccion que la cancelacion, y su
/// id es la idempotency key del pedido a MP: reintentarlo nunca reembolsa dos veces.
model Reembolso {
  id               String          @id @default(cuid())
  tenantId         String
  pagoId           String
  montoCentavos    Int
  estado           EstadoReembolso @default(pendiente)
  intentos         Int             @default(0)
  proximoIntentoAt DateTime        @default(now())
  /// El id del reembolso en Mercado Pago.
  proveedorId      String?
  ultimoError      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  pago Pago @relation(fields: [tenantId, pagoId], references: [tenantId, id])

  @@index([tenantId, estado, proximoIntentoAt])
  @@index([tenantId, pagoId])
}
