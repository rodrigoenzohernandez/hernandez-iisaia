# Copialo a .env:  cp .env.example .env
# El puerto es 5442 (no 5432 ni 5433) para no chocar con otros Postgres locales.
DATABASE_URL="postgresql://turnos:turnos@localhost:5442/turnos?schema=public"

# 3100 y no 3000: en esta maquina 3000 y 3001 suelen estar tomados por otros proyectos.
PORT=3100

# Origen del front de Next.js. Separar con coma si hay varios. Es una lista exacta, sin
# comodines: en produccion la app no arranca si algun origen es * o no es https.
CORS_ORIGIN="http://localhost:3101"

# Firma de los JWT. Sin esto la app no arranca: no hay default en el codigo, y pide 32
# caracteres o mas. Generalo con: openssl rand -base64 48
JWT_SECRET=""

# Solo detras de un proxy (Render, Railway, nginx): cuantos proxies hay delante de la API.
# El limite de peticiones cuenta por IP. Sin esta variable detras de un proxy, todas las
# requests traen la IP del proxy y el limite se comparte entre todos; prendida sin proxy,
# cualquiera falsifica X-Forwarded-For y se lo saltea. Por eso no tiene default.
# TRUST_PROXY=1

# En produccion se activan los chequeos estrictos de arranque (CORS https, etc.).
# NODE_ENV=production

# Contrasena de los usuarios administradores que siembra prisma/seed.ts.
# Minimo 12 caracteres: el seed falla si no. Generala con: openssl rand -base64 18
SEED_ADMIN_PASSWORD=""

# Peticiones por minuto permitidas en cada escritura publica (logins, alta de reserva). El
# script de verificacion necesita un valor alto porque hace decenas de altas seguidas; el
# limite real se prueba con verificacion/verificar-limite.sh contra este default.
THROTTLE_LIMIT=5
