# Copialo a .env:  cp .env.example .env
# El puerto es 5442 (no 5432 ni 5433) para no chocar con otros Postgres locales.
DATABASE_URL="postgresql://turnos:turnos@localhost:5442/turnos?schema=public"

# 3100 y no 3000: en esta maquina 3000 y 3001 suelen estar tomados por otros proyectos.
PORT=3100

# Origen del front de Next.js. Separar con coma si hay varios. Es una lista exacta, sin
# comodines: en produccion la app no arranca si algun origen es * o no es https.
CORS_ORIGIN="http://localhost:3101"

# Firma de los JWT. Sin esto la app no arranca: no hay default en el codigo, y pide 32
# caracteres o mas. Generalo con: openssl rand -base64 48
JWT_SECRET=""

# Solo detras de un proxy (Render, Railway, nginx): cuantos proxies hay delante de la API.
# El limite de peticiones cuenta por IP. Sin esta variable detras de un proxy, todas las
# requests traen la IP del proxy y el limite se comparte entre todos; prendida sin proxy,
# cualquiera falsifica X-Forwarded-For y se lo saltea. Por eso no tiene default.
# TRUST_PROXY=1

# En produccion se activan los chequeos estrictos de arranque (CORS https, etc.).
# NODE_ENV=production

# Cifra los tokens de Mercado Pago y firma los codigos de ingreso de las clientas. Sin esto
# la app no arranca. Tienen que ser 32 bytes: openssl rand -base64 32
ENCRYPTION_KEY=""

# Contrasena de los usuarios administradores que siembra prisma/seed.ts.
# Minimo 12 caracteres: el seed falla si no. Generala con: openssl rand -base64 18
SEED_ADMIN_PASSWORD=""

# Peticiones por minuto permitidas en cada escritura publica (logins, alta de reserva). El
# script de verificacion necesita un valor alto porque hace decenas de altas seguidas; el
# limite real se prueba con verificacion/verificar-limite.sh contra este default.
THROTTLE_LIMIT=5

# Mails. `log` imprime cada mail en la consola de la API (ahi se ve el codigo de ingreso de
# una clienta) y es el default en desarrollo; en produccion la app exige `resend`.
EMAIL_PROVIDER=log
# Solo con EMAIL_PROVIDER=resend. Sin dominio verificado en Resend, se manda desde
# onboarding@resend.dev y solo a la cuenta duenia de la API key.
# RESEND_API_KEY=""
# EMAIL_FROM="Lo de Lili <turnos@tu-dominio.com>"

# Pisa el intervalo de todas las tareas periodicas (mails, recordatorios...). Solo para la
# verificacion: `npm run start:verify` lo pone en 2000.
# JOBS_INTERVAL_MS=2000

# ----- Mercado Pago. Todo opcional: sin esto la API arranca y los centros no cobran online
# (turnos en efectivo sin sena, como en el MVP).

# La app de la plataforma en Mercado Pago, en modo Marketplace y con PKCE activado. Conecta
# las cuentas de los centros por OAuth ("Conectar con Mercado Pago").
# MP_CLIENT_ID=""
# MP_CLIENT_SECRET=""
# La pagina del front que recibe code y state. Fija y en HTTPS: la registra la app de MP.
# MP_REDIRECT_URI="https://tu-front/mercadopago/vuelta"

# La cuenta de la plataforma, la que cobra las suscripciones de los centros, y el secreto
# con el que MP firma los webhooks de la app (Tus integraciones -> Webhooks).
# MP_PLATFORM_ACCESS_TOKEN=""
# MP_WEBHOOK_SECRET=""

# URLs publicas para los avisos de pago (notification_url) y la vuelta de quien paga
# (back_urls). MP exige HTTPS en las dos: en local, un tunel (cloudflared o ngrok). Si no son
# HTTPS se omiten, y los pagos se confirman solo cuando llega el aviso.
# PUBLIC_API_URL="https://tu-tunel.example"
# FRONTEND_URL="https://tu-front.example"

# Credenciales de PRUEBA para conectar un centro sin pasar por OAuth. Con esto el seed conecta
# Lo de Lili, y `npm run mp:conectar-prueba -- <slug>` conecta cualquier otro. Nunca en
# produccion. Salen de Tus integraciones -> tu app -> Credenciales de prueba.
# SEED_MP_ACCESS_TOKEN=""
# SEED_MP_PUBLIC_KEY=""
# SEED_MP_USER_ID=""

# Solo para la verificacion: redirige el SDK de MP al mock. Prohibida en produccion.
# MP_API_URL="http://localhost:3199"
