# Copialo a .env:  cp .env.example .env
# Lo lee docker compose solo, por estar al lado del docker-compose.yml.
# Los dos secretos no tienen default a propósito: el compose falla con un mensaje claro
# si faltan, en vez de arrancar con un valor conocido.

# Firma de los JWT.  Generalo con:  openssl rand -base64 48
JWT_SECRET=

# Cifra los tokens de Mercado Pago de cada centro. La API no arranca sin ella.
# Generala con:  openssl rand -base64 32
ENCRYPTION_KEY=

# Contraseña de los administradores que siembra el seed. Mínimo 12 caracteres.
# Generala con:  openssl rand -base64 18
SEED_ADMIN_PASSWORD=

# Peticiones por minuto en los dos endpoints públicos que escriben (crear sesión y crear
# reserva). Con el default de 5, probar el formulario de reserva agota el límite en medio
# minuto y la API empieza a devolver 429. Para probar a mano, subilo.
THROTTLE_LIMIT=5

# Credenciales del sandbox de Mercado Pago. Sin ellas ningún centro cobra online y los turnos
# en efectivo entran confirmados, como en el MVP. Con ellas, el seed conecta a Lo de Lili.
SEED_MP_ACCESS_TOKEN=
SEED_MP_USER_ID=

# Para cobrar hace falta además una URL HTTPS que llegue a la API, donde Mercado Pago avisa
# los pagos: en local, `cloudflared tunnel --url http://localhost:3100`. Sin ella ningún centro
# cobra online. Después de pagar no hay vuelta automática al sitio (MP descarta las URLs
# http://localhost): el turno se confirma igual con el aviso.
PUBLIC_API_URL=
